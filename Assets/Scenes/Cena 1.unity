      m_Calls: []
  m_text: "Par de madeira talhada \xE0 m\xE3o, usado nos cortejos do Bumba Meu Boi.
    O estalo r\xEDtmico das matracas guia os brincantes e marca o pulso da festa.
    Este exemplar pertenceu ao grupo Boi de Maracan\xE3, circa 1940."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
